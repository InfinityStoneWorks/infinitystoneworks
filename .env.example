# Copy this file to .env and fill in your real key.
# .env is gitignored — it will never be committed.
#
# Get a key at https://console.cloud.google.com/apis/credentials
# after enabling the "Places API (New)" for your project, with billing enabled.
# Google gives a recurring monthly free credit that comfortably covers running
# this script by hand every so often — see fetch-google-reviews.mjs for details.
GOOGLE_PLACES_API_KEY=your-api-key-here
